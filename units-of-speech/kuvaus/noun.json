{"transcript":"ˈkuʋɑus","exists":true,"definitions":["Toiminta, jossa kuvataan jotakin.","Jotakin kuvaava esitys tai selitys.","Valokuvaus tai videokuvaus."],"examples":["Tarkka kuvaus tapahtumista.","Elokuvan kuvaus alkaa ensi viikolla.","Kirjan kuvaus luonnosta oli vaikuttava."],"lemma":"kuvaus","lemmaPos":"noun","synonyms":["kuvaaminen","selostus","raportti"],"number":"singular","pluralForm":"kuvaukset","source":"kuvaus"}