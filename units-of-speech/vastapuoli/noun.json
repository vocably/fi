{"transcript":"ˈʋɑstɑˌpuo̯li","exists":true,"definitions":["Osapuoli, joka on vastakkaisella puolella esimerkiksi oikeudenkäynnissä, neuvottelussa tai kilpailussa.","Vastustaja tai toinen osapuoli."],"examples":["Vastapuoli hylkäsi tarjouksen.","Oikeudenkäynnin vastapuoli saapui paikalle.","Neuvottelut vastapuolen kanssa jatkuvat."],"lemma":"vastapuoli","lemmaPos":"noun","synonyms":["vastustaja","toinen osapuoli","antagonisti"],"number":"singular","pluralForm":"vastapuolet","source":"vastapuoli","frequency":5}